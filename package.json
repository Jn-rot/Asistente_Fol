{
  "name": "asistentefinal",
  "version": "1.0.0",
  "description": "Fol: asistente conversacional de escritorio con chat, voz, imágenes y sesiones locales cifradas",
  "main": "main.js",
  "author": "Jannel (Jn-rot)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jn-rot/Asistente_Fol.git"
  },
  "homepage": "https://github.com/Jn-rot/Asistente_Fol",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --linux --win",
    "release": "electron-builder --linux --win --publish always",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.jnrot.fol",
    "productName": "Fol",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!config.js",
      "!demostraciones/**",
      "!tmp/**",
      "!*.md",
      "!LEEME-DEPENDENCIAS.txt",
      "!package-lock.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Jn-rot <243675300+Jn-rot@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Jn-rot",
      "repo": "Asistente_Fol"
    }
  },
  "keywords": [],
  "allowScripts": {
    "electron@28.3.3": true
  },
  "type": "commonjs"
}
